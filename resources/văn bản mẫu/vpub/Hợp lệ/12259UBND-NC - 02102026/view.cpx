    "ideas": [],
    "conversations": [
        {
            "senderAcode": "b45555ff-0146-1000-f6db-150813121982",
            "senderAname": "Chuyên viên C4",
            "senderName": "Văn Kim Thành",
            "senderUname": "thanhvk@vpub.gialai.gov.vn",
            "parent": 4687113,
            "createDate": "Oct 2, 2026, 8:15:03 AM",
            "createDateStr": "2026-10-02T01:15:03+00:00",
            "deadline": "Feb 1, 2200, 12:00:01 AM",
            "note": "Theo đề nghị của Sở Dân tộc và Tôn giáo, UBND tỉnh đã ban hành Kế hoạch số 383/KH-UB về Hội nghị tập huấn trang bị kiến thức khởi sự kinh doanh, khởi nghiệp và thu hút đầu tư vùng đồng bào DTTS\u0026MN năm 2026 được tổ chức tại 02 cụm (cụm Phường Quy Nhơn và cụm phường Pleiku).\nTuy nhiên do địa bàn rộng nên qua triển khai thực hiện, Sở Dân tộc và Tôn giáo đề xuất UBND tỉnh bổ sung thêm 02 cụm (cụm phường An Khê, cụm phường Ayun Pa) để tạo điều kiện thuận lợi cho đại biểu dự Hội nghị. Qua nghiên cứu, chuyên viên thống nhất với đề xuất của Sở Dân tộc và Tôn giáo. Kính trình Lãnh đạo xem xét, quyết định./.",
            "inputAname": "Phó Chánh Văn phòng",
            "inputName": "Trần Đình Triết"
        },
        {
            "senderAcode": "b43e3e51-0146-1000-f0e0-150813121982",
            "senderAname": "Phó Chánh Văn phòng",
            "senderName": "Trần Đình Triết",
            "senderUname": "triettd@vpub.gialai.gov.vn",
            "parent": 4687267,
            "createDate": "Oct 2, 2026, 10:40:01 AM",
            "createDateStr": "2026-10-02T03:40:01+00:00",
            "deadline": "Feb 1, 2200, 12:00:01 AM",
            "note": "Kính trình đ/c Tiệp - PCT UBND tỉnh xem xét, ký ban hành",
            "inputAname": "Phó Chủ tịch UBND tỉnh",
            "inputName": "Dương Mah Tiệp"
        }
    ],
