# Copy to .env locally. Keep secrets out of userscripts and version control.
SENDER_HOST=127.0.0.1
SENDER_PORT=8001
SENDER_API_KEY=
SENDER_LOOKUP_DB=resources/data/lookup.db
SENDER_POLICY_PATH=resources/policies/recipient_aliases.v1.json
SENDER_RUNTIME_DIR=var

# Default offline; cloud requests require explicit cloud mode AND configured models/key.
SENDER_PROVIDER_MODE=offline
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
OPENROUTER_URL=https://openrouter.ai/api/v1
SENDER_PROVIDER_TIMEOUT_SECONDS=60
SENDER_PROVIDER_MAX_RETRIES=2
SENDER_MAX_FILE_BYTES=20971520
SENDER_MAX_PAGES=100
SENDER_MAX_VISION_PAGES=6
# Optional absolute directory containing Poppler pdftoppm executable.
SENDER_POPPLER_PATH=
SENDER_LEASE_SECONDS=300
SENDER_MAX_PENDING_JOBS=32
SENDER_RETENTION_DAYS=7
